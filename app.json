{
  "expo": {
    "name": "pitad",
    "slug": "pitad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "pitad",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pitad.running"
    },
    "android": {
      "package": "com.pitad.running",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      ["expo-location", {
        "locationWhenInUsePermission": "Allow pitad to record your route and running distance while you run.",
        "locationAlwaysAndWhenInUsePermission": "Allow pitad to keep recording your run when your screen is locked or you switch apps.",
        "isIosBackgroundLocationEnabled": true,
        "isAndroidBackgroundLocationEnabled": true,
        "isAndroidForegroundServiceEnabled": true
      }]
    ]
  }
}
